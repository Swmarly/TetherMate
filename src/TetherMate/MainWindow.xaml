<Window x:Class="TetherMate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="TetherMate"
        Icon="ico/TetherMateLogo.png"
        Width="920"
        Height="760"
        MinWidth="820"
        MinHeight="660"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource AppBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource HeaderBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <Grid Margin="26,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image Width="38" Height="38" Source="ico/TetherMateLogo.png" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="TetherMate" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Virtual Desktop over USB" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
        <Border Grid.Column="2"
                Style="{StaticResource ToneBadgeStyle}"
                Tag="{Binding StatusTone}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource ToneDotStyle}"
                     Tag="{Binding StatusTone}"
                     Margin="0,0,7,0" />
            <TextBlock Text="{Binding StatusTitle}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="26">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5*" />
          <ColumnDefinition Width="18" />
          <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <Border Style="{StaticResource HeroCardStyle}"
                  Tag="{Binding StatusTone}"
                  Padding="26">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <Border Width="46"
                        Height="46"
                        CornerRadius="23"
                        Background="{StaticResource AccentSoftBrush}"
                        VerticalAlignment="Top">
                  <Path Data="M 5 3 L 15 3 L 15 11 L 19 11 L 19 21 L 1 21 L 1 11 L 5 11 Z M 7 6 L 7 10 M 13 6 L 13 10 M 5 15 C 8 12, 12 12, 15 15 M 7 17 C 9 15, 11 15, 13 17"
                        Stroke="{StaticResource AccentBrush}"
                        StrokeThickness="1.5"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Stretch="Uniform"
                        Width="24"
                        Height="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="16,0,0,0">
                  <TextBlock Text="{Binding StatusTitle}"
                             FontSize="28"
                             FontWeight="SemiBold"
                             LineHeight="34" />
                  <TextBlock Text="{Binding StatusDetail}"
                             Margin="0,7,0,0"
                             FontSize="14"
                             LineHeight="21"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             MaxWidth="520" />
                </StackPanel>
              </StackPanel>

              <Border Margin="0,24,0,0"
                      Padding="14"
                      Background="{StaticResource SurfaceElevatedBrush}"
                      CornerRadius="11">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding SelectedDeviceName}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedDeviceSerial}"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="1"
                             Text="{Binding DeviceCountLabel}"
                             VerticalAlignment="Center"
                             FontSize="11"
                             Foreground="{StaticResource TextSecondaryBrush}" />
                </Grid>
              </Border>

              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="{Binding ConnectionActionText}"
                        Command="{Binding ToggleConnectionCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Grid.Column="1"
                        Content="Restart link"
                        Command="{Binding RestartCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0" />
                <Button Grid.Column="2"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="10,0,0,0" />
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold" />
                <Button Grid.Column="1"
                        Content="Clear"
                        Command="{Binding ClearActivityCommand}"
                        Style="{StaticResource LinkButtonStyle}" />
              </Grid>
              <Border Margin="0,14,0,0"
                      Background="{StaticResource AppBackgroundBrush}"
                      CornerRadius="10"
                      Padding="10">
                <ListBox ItemsSource="{Binding Activity}"
                         Height="180"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="4,5" />
                      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="58" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Time}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="11"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Message}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
          <Border Style="{StaticResource CardStyle}">
            <StackPanel>
              <TextBlock Text="Connection path" FontSize="16" FontWeight="SemiBold" />
              <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource ToneDotStyle}"
                         Tag="{Binding AdbStepTone}"
                         VerticalAlignment="Top"
                         Margin="0,5,0,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Android bridge" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding AdbStepDetail}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </Grid>
              <Border Height="22" Width="1" Background="{StaticResource BorderBrush}" Margin="5,2,0,2" HorizontalAlignment="Left" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource ToneDotStyle}"
                         Tag="{Binding DeviceStepTone}"
                         VerticalAlignment="Top"
                         Margin="0,5,0,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="USB headset" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding DeviceStepDetail}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </Grid>
              <Border Height="22" Width="1" Background="{StaticResource BorderBrush}" Margin="5,2,0,2" HorizontalAlignment="Left" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="22" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Style="{StaticResource ToneDotStyle}"
                         Tag="{Binding TunnelStepTone}"
                         VerticalAlignment="Top"
                         Margin="0,5,0,0" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="Headset VPN" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding TunnelStepDetail}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="Headset" FontSize="16" FontWeight="SemiBold" />
              <TextBlock Text="Target device" Margin="0,15,0,6" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
              <ComboBox ItemsSource="{Binding Devices}"
                        SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                        DisplayMemberPath="DisplayName" />
              <TextBlock Text="{Binding AdbVersion}"
                         Margin="0,10,0,0"
                         FontSize="10"
                         Foreground="{StaticResource TextMutedBrush}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="Behavior" FontSize="16" FontWeight="SemiBold" />
              <CheckBox Content="Connect automatically when ready"
                        IsChecked="{Binding AutoConnect}"
                        Style="{StaticResource SwitchStyle}"
                        Margin="0,16,0,0" />
              <CheckBox Content="Keep running in the tray"
                        IsChecked="{Binding CloseToTray}"
                        Style="{StaticResource SwitchStyle}"
                        Margin="0,14,0,0" />
            </StackPanel>
          </Border>

          <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" />
                <Button Grid.Column="1"
                        Content="Run checks"
                        Command="{Binding DiagnoseCommand}"
                        Style="{StaticResource LinkButtonStyle}" />
              </Grid>
              <StackPanel Visibility="{Binding IsDiagnosticsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,12,0,0">
                <TextBlock Text="{Binding DiagnosticsSummary}"
                           FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Diagnostics}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="18" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Style="{StaticResource ToneDotStyle}"
                                 Tag="{Binding Tone}"
                                 Width="8"
                                 Height="8"
                                 Margin="0,4,0,0"
                                 VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}"
                                     FontSize="10"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Copy results"
                        Command="{Binding CopyDiagnosticsCommand}"
                        Style="{StaticResource LinkButtonStyle}"
                        Margin="0,7,0,0" />
              </StackPanel>
              <Separator Margin="0,12" Background="{StaticResource BorderBrush}" />
              <Button Content="Repair headset client"
                      Command="{Binding RepairClientCommand}"
                      ToolTip="Reinstall the bundled VPN helper and rebuild the USB link"
                      Style="{StaticResource LinkButtonStyle}" />
              <Button Content="Setup guide" Command="{Binding OpenSetupGuideCommand}" Style="{StaticResource LinkButtonStyle}" />
              <Button Content="Open local logs" Command="{Binding OpenLogsCommand}" Style="{StaticResource LinkButtonStyle}" />
              <Button Content="Third-party notices" Command="{Binding OpenNoticesCommand}" Style="{StaticResource LinkButtonStyle}" />
              <TextBlock Text="{Binding AppVersion, StringFormat=TetherMate {0}}"
                         Margin="0,8,0,0"
                         FontSize="10"
                         Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
