<Application x:Class="TetherMate.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown"
             ThemeMode="Dark">
  <Application.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0A0E13" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#0D1218" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111820" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="#18212B" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#202C38" />
    <SolidColorBrush x:Key="BorderBrush" Color="#253240" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F7FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9DAAB8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#718091" />
    <SolidColorBrush x:Key="AccentBrush" Color="#32A9FF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#168FE8" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#17364D" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#153B30" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB454" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#43321A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF7182" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#45212A" />
    <SolidColorBrush x:Key="NeutralBrush" Color="#718091" />
    <SolidColorBrush x:Key="NeutralSoftBrush" Color="#222B35" />

    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
      <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="HeroCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
      <Style.Triggers>
        <Trigger Property="Tag" Value="Success">
          <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Warning">
          <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Error">
          <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Accent">
          <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="#07131D" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
          <Setter Property="Foreground" Value="White" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="15,9" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="LinkButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="0,5" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ToneDotStyle" TargetType="Ellipse">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Fill" Value="{StaticResource NeutralBrush}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Success">
          <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Warning">
          <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Error">
          <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Accent">
          <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ToneBadgeStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource NeutralSoftBrush}" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,4" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="Success">
          <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Warning">
          <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Error">
          <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}" />
        </Trigger>
        <Trigger Property="Tag" Value="Accent">
          <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SwitchStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent" Cursor="Hand">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" />
              <Border x:Name="Track"
                      Grid.Column="1"
                      Width="38"
                      Height="22"
                      Margin="14,0,0,0"
                      CornerRadius="11"
                      Background="{StaticResource NeutralSoftBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1">
                <Ellipse x:Name="Thumb"
                         Width="16"
                         Height="16"
                         Margin="2"
                         HorizontalAlignment="Left"
                         Fill="{StaticResource TextSecondaryBrush}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter TargetName="Thumb" Property="Fill" Value="White" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    </Style>
  </Application.Resources>
</Application>
